APP_NAME="CMS Pondok"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.pondok.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

ADMIN_DOMAIN=admin.pondok.test
SITE_PONDOK_DOMAIN=pondok.test
SITE_MAHAD_DOMAIN=mahad.test

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cms_ready
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Any S3-compatible storage (AWS, MinIO, R2, Wasabi). Set MEDIA_DISK=s3 to use it.

VITE_APP_NAME="${APP_NAME}"

# SIAKAD integration (docs/siakad-api-spec.md). driver: fake (local) or http.
SIAKAD_DRIVER=fake
SIAKAD_BASE_URL=
SIAKAD_API_KEY=
SIAKAD_WEBHOOK_SECRET=
SIAKAD_SITE=mahad

# Social media publishing (docs/social-review.md). driver: fake (demo) or live.
SOCIAL_DRIVER=fake
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Operations (docs/deployment.md). Run `php artisan cms:check` after deploying.
CMS_ALERT_EMAIL=
# IPs/CIDRs of a load balancer or CDN in front of nginx ("*" trusts all).
TRUSTED_PROXIES=
HSTS_MAX_AGE=31536000
SESSION_SECURE_COOKIE=false
HORIZON_MAX_PROCESSES=5

# Backups (spatie/laravel-backup): database + storage/app, nightly at 02:00.
BACKUP_NAME=cms-pondok
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_MEGABYTES=10000
# Set when pg_dump is not on the PATH, e.g. "C:\Program Files\PostgreSQL\17\bin".
DB_DUMP_BINARY_PATH=
# Off-site "backups" disk (add it to BACKUP_DISKS). Falls back to the AWS_* keys.
BACKUP_AWS_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_AWS_ENDPOINT=
